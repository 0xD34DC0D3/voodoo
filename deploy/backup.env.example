# Off-box backup config, sourced by /usr/local/bin/voodoo-backup.
# Install as /etc/voodoo/backup.env, root:root 0600. Not readable by the
# voodoo service account: it holds AWS credentials.
#
# Off-box upload is all-or-nothing. Leave all four of S3_URI, AGE_RECIPIENT
# and the two AWS keys empty (or omit this file) for local-only backups:
# supported, but not recommended for production, since a lost disk loses
# every backup. Setting some but not all of them fails the backup run, and
# with it `make deploy`.
VOODOO_BACKUP_S3_URI=s3://BUCKET_NAME/voodoo
VOODOO_BACKUP_AGE_RECIPIENT=age1...
# Optional dead-man's-switch ping URL; <url>/fail is hit on error.
VOODOO_BACKUP_HEALTHCHECK_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
