# Production environment for voodoo, read by systemd (EnvironmentFile).
# On the server this lives at /etc/voodoo/voodoo.env (owned root, mode 0640,
# group voodoo). Copy this file there and adjust.
VOODOO_DB_PATH=/var/lib/voodoo/voodoo.db
VOODOO_PORT=8080
# Interface the listener binds to. Caddy is the only intended client and
# proxies to 127.0.0.1, so keep this on loopback. Set to empty for all interfaces.
VOODOO_BIND=127.0.0.1
# Placeholders: auth.example.com is voodoo's host, example.com its parent domain.
VOODOO_BASE_URL=https://auth.example.com
VOODOO_SITE_URL=https://example.com
# Set to the parent domain (leading dot) to share the session cookie across
# sibling subdomains — e.g. so app.example.com can federate auth to voodoo.
# Changing this invalidates existing cookies (everyone re-logs in once). Leave
# empty for local dev so the cookie stays host-only on localhost.
VOODOO_COOKIE_DOMAIN=.example.com
VOODOO_COOKIE_SECURE=true
VOODOO_SESSION_TTL_DAYS=30
VOODOO_LOG_LEVEL=info
