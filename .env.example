# Local-dev defaults. Copy to .env and adjust.
VOODOO_DB_PATH=./voodoo.db
VOODOO_PORT=8080
VOODOO_BASE_URL=http://localhost:8080
VOODOO_COOKIE_DOMAIN=
VOODOO_COOKIE_SECURE=false
VOODOO_SESSION_TTL_DAYS=30
VOODOO_LOG_LEVEL=info

# OAuth token lifetimes (see docs/oauth.md). The refresh TTL is an absolute
# ceiling on an approval, not a sliding window.
VOODOO_OAUTH_ACCESS_TTL_MINUTES=60
VOODOO_OAUTH_REFRESH_TTL_DAYS=30
